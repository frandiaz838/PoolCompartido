<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PoolCompartido.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:PoolCompartido"
    Title="PoolCompartido">

    <!-- Dos pestañas: la lista general y los viajes del usuario -->
    <TabBar>
        <ShellContent
            Title="Viajes disponibles"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />
        <ShellContent
            Title="Mis viajes"
            ContentTemplate="{DataTemplate local:MisViajesPage}"
            Route="MisViajesPage" />
    </TabBar>

</Shell>
