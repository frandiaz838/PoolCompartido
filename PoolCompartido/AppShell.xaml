<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PoolCompartido.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:PoolCompartido"
    Title="Coopul">

    <!-- Dos pestañas: la lista general y los viajes del usuario.
         Cada una con ícono, como en cualquier app de celular; la elegida se marca con el color de la app. -->
    <TabBar>
        <ShellContent
            Title="Viajes disponibles"
            Icon="tab_viajes.png"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />
        <ShellContent
            Title="Mis viajes"
            Icon="tab_misviajes.png"
            ContentTemplate="{DataTemplate local:MisViajesPage}"
            Route="MisViajesPage" />
    </TabBar>

</Shell>
