<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PoolCompartido"
             x:Class="PoolCompartido.MainPage"
             Title="Viajes disponibles">

    <!-- Ícono de perfil arriba a la derecha -->
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Mi perfil" IconImageSource="perfil.png" Clicked="OnPerfilClicked" />
    </ContentPage.ToolbarItems>

    <!-- En pantallas anchas (compu) el contenido no se estira de punta a punta -->
    <Grid Padding="16" RowSpacing="12" RowDefinitions="Auto,*,Auto,Auto" MaximumWidthRequest="980">

        <!-- HU2: filtros por destino y franja horaria (se aplican solos al escribir o elegir) -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <Entry x:Name="entryDestino"
                   Grid.Column="0"
                   Placeholder="Filtrar por destino"
                   TextChanged="OnDestinoCambiado" />
            <Picker x:Name="pickerHorario"
                    Grid.Column="1"
                    Title="Franja"
                    WidthRequest="120"
                    SelectedIndexChanged="OnHorarioCambiado" />
            <Button Grid.Column="2"
                    Text="Limpiar"
                    Clicked="OnLimpiarClicked" />
        </Grid>

        <!-- HU2: lista de viajes -->
        <CollectionView x:Name="listaViajes" Grid.Row="1" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="No hay viajes para ese filtro."
                       HorizontalOptions="Center"
                       Margin="0,30" />
            </CollectionView.EmptyView>
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:Viaje">
                    <Border Style="{StaticResource TarjetaViaje}">
                        <VerticalStackLayout Spacing="10">
                            <!-- Encabezado: ruta, y si el viaje es mío o ya estoy anotado -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Ruta}" FontSize="18" FontAttributes="Bold" />
                                    <Label Text="{Binding Detalle}" Style="{StaticResource TextoSecundario}" />
                                </VerticalStackLayout>
                                <Border Grid.Column="1" Style="{StaticResource Etiqueta}" IsVisible="{Binding EstoyAnotado}"
                                        BackgroundColor="{AppThemeBinding Light=#E3F4EA, Dark=#1F3A2B}">
                                    <Label Text="✓ Anotado" FontSize="12" FontAttributes="Bold" TextColor="#2E9E5B" />
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource Etiqueta}" IsVisible="{Binding EsDelUsuarioActual}">
                                    <Label Text="Tu viaje" FontSize="12" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                </Border>
                            </Grid>

                            <!-- Datos del viaje -->
                            <VerticalStackLayout Spacing="3">
                                <!-- HU24: punto de partida público del conductor -->
                                <Label Text="{Binding PuntoPartidaTexto}" Style="{StaticResource TextoSecundario}" IsVisible="{Binding TienePuntoPartida}" />
                                <Label Text="{Binding AsientosDisponibles, StringFormat='Asientos libres: {0}'}" Style="{StaticResource TextoSecundario}" />
                                <!-- HU14: cuánto paga cada pasajero (solo en viajes con costo) -->
                                <Label Text="{Binding CostoTexto}" FontSize="14" FontAttributes="Bold" IsVisible="{Binding TieneCosto}" />
                            </VerticalStackLayout>

                            <!-- Acciones -->
                            <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Start" Margin="0,0,0,-8">
                                <!-- HU3: anotarse (no aparece en tus viajes ni donde ya estás anotado) -->
                                <Button Text="Anotarme" Style="{StaticResource BotonPrincipal}"
                                        IsVisible="{Binding PuedeAnotarse}" Clicked="OnAnotarmeClicked" />
                                <!-- HU22: ver el recorrido en Google Maps -->
                                <Button Text="Ver ruta" Style="{StaticResource BotonSecundario}"
                                        Clicked="OnVerRutaClicked" />
                            </FlexLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Aviso que muestran los eventos (por ejemplo, la notificación al conductor) -->
        <Border x:Name="panelAviso"
                Grid.Row="2"
                IsVisible="False"
                Padding="10"
                StrokeShape="RoundRectangle 8"
                Stroke="#512BD4"
                BackgroundColor="{AppThemeBinding Light=#EFEAFB, Dark=#2A2340}">
            <Label x:Name="lblAviso" FontSize="13" />
        </Border>

        <!-- HU1: publicar -->
        <Button Grid.Row="3"
                Text="Publicar un viaje"
                FontAttributes="Bold"
                Clicked="OnPublicarClicked" />
    </Grid>

</ContentPage>
