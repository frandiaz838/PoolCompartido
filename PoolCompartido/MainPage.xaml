<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PoolCompartido"
             x:Class="PoolCompartido.MainPage"
             Title="Viajes disponibles">

    <!-- Ícono de perfil arriba a la derecha -->
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Mi perfil" IconImageSource="perfil.png" Clicked="OnPerfilClicked" />
    </ContentPage.ToolbarItems>

    <ContentPage.Resources>
        <local:ColorAvatarConverter x:Key="ColorAvatar" />
    </ContentPage.Resources>

    <!-- Filtros arriba, la lista y el botón de publicar abajo.
         En pantallas anchas (compu) todo queda en una columna central: no se estira de punta a punta -->
    <Grid Padding="{StaticResource RellenoPagina}"
          RowSpacing="{StaticResource EspacioM}"
          RowDefinitions="Auto,*,Auto"
          MaximumWidthRequest="{StaticResource AnchoLista}">

        <!-- Mejora de la HU2 (idea de Carpoolear): desde / hacia con botón para invertir, día y franja -->
        <VerticalStackLayout x:Name="panelFiltros" Grid.Row="0" Spacing="{StaticResource EspacioS}">
            <Label Text="¿A dónde querés viajar?" Style="{StaticResource Titulo}" FontSize="{StaticResource TamanoGrande}" />

            <!-- Rótulo arriba de cada campo y un ejemplo adentro. Fila 0: rótulos; fila 1: campos -->
            <Grid ColumnDefinitions="*,Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource EspacioS}" RowSpacing="{StaticResource EspacioXS}">
                <Label Grid.Row="0" Grid.Column="0" Text="Desde" Style="{StaticResource RotuloCampo}" Margin="0" />
                <Label Grid.Row="0" Grid.Column="2" Text="Hacia" Style="{StaticResource RotuloCampo}" Margin="0" />
                <!-- Desde con el botón 📍 para completarlo con el barrio donde estoy (como en Publicar) -->
                <Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource EspacioXS}">
                    <Entry x:Name="entryOrigen"
                           Placeholder="Ej: Saldán"
                           SemanticProperties.Description="Desde, filtrar por origen"
                           TextChanged="OnFiltroTextoCambiado" />
                    <Button x:Name="btnUbicacionDesde"
                            Grid.Column="1"
                            Text="📍"
                            FontSize="{StaticResource TamanoMediano}"
                            Padding="0"
                            WidthRequest="44"
                            Style="{StaticResource BotonSecundario}"
                            Margin="0"
                            VerticalOptions="Center"
                            SemanticProperties.Description="Usar mi ubicación en Desde"
                            ToolTipProperties.Text="Usar mi ubicación"
                            Clicked="OnUbicacionDesdeClicked" />
                </Grid>
                <!-- Invierte desde y hacia (para buscar la vuelta) -->
                <Button Grid.Row="1"
                        Grid.Column="1"
                        Text="⇄"
                        FontSize="{StaticResource TamanoGrande}"
                        Padding="12,0"
                        Style="{StaticResource BotonSecundario}"
                        Margin="0"
                        VerticalOptions="Center"
                        SemanticProperties.Description="Invertir desde y hacia"
                        ToolTipProperties.Text="Invertir desde y hacia"
                        Clicked="OnInvertirClicked" />
                <Entry x:Name="entryDestino"
                       Grid.Row="1"
                       Grid.Column="2"
                       Placeholder="Ej: UBP"
                       SemanticProperties.Description="Hacia, filtrar por destino"
                       TextChanged="OnFiltroTextoCambiado" />
            </Grid>

            <!-- Día y franja a lo ancho, así se lee la opción completa ("Cualquier día") también en el celular.
                 El rótulo va aparte (igual que Desde y Hacia). El Title es el título de la lista que se abre en Android;
                 en Windows va vacío porque ahí se muestra como un segundo rótulo repetido -->
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource EspacioS}" RowSpacing="{StaticResource EspacioXS}">
                <Label Grid.Row="0" Grid.Column="0" Text="Día" Style="{StaticResource RotuloCampo}" Margin="0" />
                <Label Grid.Row="0" Grid.Column="1" Text="Horario" Style="{StaticResource RotuloCampo}" Margin="0" />
                <Picker x:Name="pickerDia"
                        Grid.Row="1"
                        Grid.Column="0"
                        Title="{OnPlatform Default='Día', WinUI=''}"
                        SemanticProperties.Description="Filtrar por día"
                        SelectedIndexChanged="OnHorarioCambiado" />
                <Picker x:Name="pickerHorario"
                        Grid.Row="1"
                        Grid.Column="1"
                        Title="{OnPlatform Default='Horario', WinUI=''}"
                        SemanticProperties.Description="Filtrar por horario"
                        SelectedIndexChanged="OnHorarioCambiado" />
            </Grid>
            <!-- Aparece solo cuando hay algún filtro puesto (así no ocupa lugar en el celular) -->
            <Button x:Name="btnLimpiar"
                    Text="✕ Limpiar filtros"
                    Style="{StaticResource BotonTexto}"
                    HorizontalOptions="End"
                    IsVisible="False"
                    SemanticProperties.Description="Limpiar los filtros"
                    Clicked="OnLimpiarClicked" />
        </VerticalStackLayout>

        <!-- HU2: lista de viajes -->
        <CollectionView x:Name="listaViajes" Grid.Row="1" SelectionMode="None">
            <!-- La tarjeta "Tu próximo viaje" va como encabezado de la lista: en el celular se va con el scroll
                 y deja lugar para ver los viajes (los filtros quedan fijos arriba) -->
            <CollectionView.Header>
                <!-- HU29: "Tu próximo viaje" — lo primero que se ve, con las acciones del momento -->
                <Border x:Name="tarjetaProximo"
                        x:DataType="local:Viaje"
                        Margin="0,0,0,12"
                        IsVisible="False"
                        Padding="18,16"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 18"
                        Background="{AppThemeBinding Light={StaticResource FondoHeroClaro}, Dark={StaticResource FondoHeroOscuro}}">
                    <VerticalStackLayout Spacing="{StaticResource EspacioS}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource EspacioS}">
                            <Label Text="TU PRÓXIMO VIAJE"
                                   FontSize="{StaticResource TamanoChico}"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource ColorSobreHeroSuave}"
                                   CharacterSpacing="1"
                                   VerticalOptions="Center"
                                   SemanticProperties.HeadingLevel="Level2" />
                            <Border Grid.Column="1" Padding="10,2" StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                    BackgroundColor="{StaticResource ColorHeroEtiqueta}" IsVisible="{Binding MostrarEstado}">
                                <Label Text="{Binding EstadoTexto}" FontSize="{StaticResource TamanoChico}" FontAttributes="Bold"
                                       TextColor="{StaticResource ColorSobreHero}" />
                            </Border>
                        </Grid>
                        <Label Text="{Binding Ruta}" FontSize="{StaticResource TamanoTitulo}" FontAttributes="Bold"
                               TextColor="{StaticResource ColorSobreHero}" />
                        <Label FontSize="{StaticResource TamanoNormal}" TextColor="{StaticResource ColorSobreHeroSuave}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding DiaTexto}" FontAttributes="Bold" />
                                    <Span Text=" · " />
                                    <Span Text="{Binding Hora}" FontAttributes="Bold" />
                                    <Span Text=" hs · " />
                                    <Span Text="{Binding RolUsuarioActual}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Label Text="{Binding PartidaChip}" FontSize="{StaticResource TamanoNormal}"
                               TextColor="{StaticResource ColorSobreHeroSuave}" IsVisible="{Binding TienePuntoPartida}" />
                        <FlexLayout Wrap="Wrap" Direction="Row" Margin="0,4,0,-8">
                            <Button Text="Ver ruta" Style="{StaticResource BotonHero}" Clicked="OnProximoRutaClicked" />
                            <Button Text="{Binding TextoBotonChat}" Style="{StaticResource BotonHeroContorno}"
                                    IsVisible="{Binding PuedeChatear}" Clicked="OnProximoChatClicked" />
                            <Button Text="Ver en Mis viajes" Style="{StaticResource BotonHeroContorno}" Clicked="OnProximoVerClicked" />
                        </FlexLayout>
                    </VerticalStackLayout>
                </Border>
            </CollectionView.Header>

            <!-- Lista vacía: qué pasó y qué se puede hacer -->
            <!-- Lista vacía: va como pie de la lista (no como EmptyView), porque en Android el EmptyView junto con el
                 encabezado ("Tu próximo viaje") quedaba cortado. Se muestra solo cuando no hay viajes (MainPage.xaml.cs) -->
            <CollectionView.Footer>
                <VerticalStackLayout x:Name="panelVacio" IsVisible="False" HorizontalOptions="Center" Margin="0,32"
                                     Spacing="{StaticResource EspacioS}" Padding="16,0">
                    <Label Text="🚗" Style="{StaticResource EstadoVacioIcono}" />
                    <Label Text="No hay viajes para mostrar" Style="{StaticResource EstadoVacioTitulo}" />
                    <!-- Sin botones acá: "Publicar un viaje" ya está abajo y "Limpiar filtros" aparece arriba si hay filtros -->
                    <Label Text="Probá con otros filtros o publicá el tuyo con el botón de abajo para que se sumen otros."
                           Style="{StaticResource EstadoVacioTexto}" />
                </VerticalStackLayout>
            </CollectionView.Footer>
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:Viaje">
                    <!-- En Windows la barra de desplazamiento va encima del contenido: margen a la derecha para que no tape la tarjeta -->
                    <Border Style="{StaticResource TarjetaViaje}" Margin="{OnPlatform Default='0', WinUI='0,0,14,0'}">
                        <VerticalStackLayout Spacing="10">
                            <!-- HU30: coincide con uno de mis horarios habituales -->
                            <Border Style="{StaticResource Etiqueta}" HorizontalOptions="Start" IsVisible="{Binding CoincideConMiHorario}"
                                    BackgroundColor="{DynamicResource ColorAvisoFondo}">
                                <Label Text="{Binding CoincidenciaTexto}" Style="{StaticResource EtiquetaTexto}" TextColor="{DynamicResource ColorAviso}" />
                            </Border>

                            <!-- Encabezado: recorrido en vertical (idea de Carpoolear) y si el viaje es mío o ya estoy anotado -->
                            <Grid ColumnDefinitions="14,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                                <!-- Línea que une el origen con el destino -->
                                <BoxView Grid.RowSpan="2" Style="{StaticResource LineaRecorrido}" />
                                <!-- Punto de origen (hueco) y de destino (lleno) -->
                                <Border Grid.Row="0" Style="{StaticResource PuntoOrigen}" />
                                <Border Grid.Row="1" Style="{StaticResource PuntoDestino}" />
                                <VerticalStackLayout Grid.Column="1" Grid.Row="0" Spacing="1">
                                    <Label Text="{Binding Origen}" Style="{StaticResource TextoLugar}" />
                                    <!-- HU24: punto de partida público del conductor -->
                                    <Label Text="{Binding PuntoPartidaTexto}" Style="{StaticResource TextoSecundario}" IsVisible="{Binding TienePuntoPartida}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Grid.Row="1" Text="{Binding Destino}" Style="{StaticResource TextoLugar}" />
                                <Border Grid.Column="2" Style="{StaticResource Etiqueta}" IsVisible="{Binding EstoyAnotado}"
                                        BackgroundColor="{DynamicResource ColorExitoFondo}">
                                    <Label Text="✓ Anotado" Style="{StaticResource EtiquetaTexto}" TextColor="{DynamicResource ColorExito}" />
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Etiqueta}" IsVisible="{Binding EsDelUsuarioActual}">
                                    <Label Text="Tu viaje" Style="{StaticResource EtiquetaTexto}" />
                                </Border>
                            </Grid>

                            <!-- HU29: quiénes viajan (conductor primero) -->
                            <!-- Grid (no HorizontalStackLayout): así en el celular el texto se acomoda en vez de cortarse.
                                 Sin ColumnSpacing: si no hay "+N", la columna vacía dejaba un hueco doble antes del texto -->
                            <Grid ColumnDefinitions="Auto,Auto,*">
                                <HorizontalStackLayout Grid.Column="0" Spacing="-8" BindableLayout.ItemsSource="{Binding AvataresVisibles}" VerticalOptions="Center">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="local:Participante">
                                            <Border Style="{StaticResource Avatar}"
                                                    BackgroundColor="{Binding Color, Converter={StaticResource ColorAvatar}}"
                                                    SemanticProperties.Description="{Binding Descripcion}">
                                                <Label Text="{Binding InicialesTexto}" Style="{StaticResource AvatarTexto}" />
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </HorizontalStackLayout>
                                <Label Grid.Column="1" Text="{Binding AvataresExtra}" IsVisible="{Binding HayAvataresExtra}" Margin="6,0,0,0"
                                       Style="{StaticResource TextoSecundario}" FontAttributes="Bold" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="{Binding ParticipantesTexto}" Style="{StaticResource TextoSecundario}" Margin="10,0,0,0"
                                       VerticalOptions="Center" MaxLines="2" LineBreakMode="WordWrap" />
                            </Grid>

                            <!-- HU29: datos cortos en chips -->
                            <FlexLayout Wrap="Wrap" Direction="Row" Margin="0,0,0,-6">
                                <Border Style="{StaticResource Chip}">
                                    <Label Text="{Binding HoraChip}" Style="{StaticResource ChipTexto}" />
                                </Border>
                                <!-- Lugares con color según cuántos quedan (siempre con el texto, sirve también en modo daltónico) -->
                                <Border Style="{StaticResource ChipLugares}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding Lugares}" Value="{x:Static local:NivelLugares.Pocos}">
                                            <Setter Property="BackgroundColor" Value="{DynamicResource ColorAvisoFondo}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding Lugares}" Value="{x:Static local:NivelLugares.Completo}">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ColorSuperficieAlternativaClaro}, Dark={StaticResource ColorSuperficieAlternativaOscuro}}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="{Binding AsientosChip}" Style="{StaticResource ChipLugaresTexto}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Lugares}" Value="{x:Static local:NivelLugares.Pocos}">
                                                <Setter Property="TextColor" Value="{DynamicResource ColorAviso}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding Lugares}" Value="{x:Static local:NivelLugares.Completo}">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ColorTextoSecundarioClaro}, Dark={StaticResource ColorTextoSecundarioOscuro}}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                                <!-- HU14: cuánto pagaría (solo en viajes con costo) -->
                                <Border Style="{StaticResource Chip}" IsVisible="{Binding TieneCostoChip}">
                                    <Label Text="{Binding CostoChip}" Style="{StaticResource ChipTexto}" />
                                </Border>
                                <!-- HU31: promedio de calificaciones del conductor, para saber con quién me anoto -->
                                <!-- En mis propios viajes no se muestra (sería mi calificación) -->
                                <ContentView>
                                    <ContentView.Triggers>
                                        <DataTrigger TargetType="ContentView" Binding="{Binding EsDelUsuarioActual}" Value="True">
                                            <Setter Property="IsVisible" Value="False" />
                                        </DataTrigger>
                                    </ContentView.Triggers>
                                    <Border Style="{StaticResource Chip}" IsVisible="{Binding TieneCalificacionChip}">
                                        <Label Text="{Binding CalificacionChip}" Style="{StaticResource ChipTexto}" />
                                    </Border>
                                </ContentView>
                            </FlexLayout>

                            <!-- Acciones -->
                            <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Start" Margin="0,0,0,-8">
                                <!-- HU3: anotarse (no aparece en tus viajes ni donde ya estás anotado) -->
                                <Button Text="Anotarme" Style="{StaticResource BotonPrincipal}"
                                        IsVisible="{Binding PuedeAnotarse}" Clicked="OnAnotarmeClicked" />
                                <!-- HU22: ver el recorrido en Google Maps -->
                                <Button Text="Ver ruta" Style="{StaticResource BotonSecundario}"
                                        Clicked="OnVerRutaClicked" />
                            </FlexLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- HU26: los avisos de los eventos ya no van acá abajo: los muestra el cartel de notificaciones
             en cualquier pantalla, y quedan guardados en el centro de notificaciones (campanita) -->

        <!-- HU1: publicar -->
        <Button x:Name="btnPublicar"
                Grid.Row="2"
                Text="Publicar un viaje"
                Clicked="OnPublicarClicked" />
    </Grid>

</ContentPage>
