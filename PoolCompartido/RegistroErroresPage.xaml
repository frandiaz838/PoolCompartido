<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PoolCompartido.RegistroErroresPage"
             Title="Registro de errores">

    <Grid Padding="16" RowSpacing="10" RowDefinitions="Auto,*">

        <!-- Dónde están los archivos, útil para mostrarlos en la presentación -->
        <Label x:Name="lblRutas" Grid.Row="0" FontSize="12" />

        <ScrollView Grid.Row="1">
            <Label x:Name="lblContenido" FontSize="13" />
        </ScrollView>
    </Grid>

</ContentPage>
