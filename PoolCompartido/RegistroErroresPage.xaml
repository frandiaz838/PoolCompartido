<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PoolCompartido.RegistroErroresPage"
             Title="Registro de errores"
             Shell.TabBarIsVisible="False">

    <Grid Padding="{StaticResource RellenoPagina}" RowSpacing="10" RowDefinitions="Auto,*" MaximumWidthRequest="{StaticResource AnchoLectura}">

        <!-- Dónde están los archivos, útil para mostrarlos en la presentación -->
        <Label x:Name="lblRutas" Grid.Row="0" Style="{StaticResource TextoAyuda}" />

        <ScrollView Grid.Row="1">
            <Label x:Name="lblContenido" FontSize="{StaticResource TamanoChico}" />
        </ScrollView>
    </Grid>

</ContentPage>
