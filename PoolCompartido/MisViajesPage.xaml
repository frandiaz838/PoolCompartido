<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PoolCompartido"
             x:Class="PoolCompartido.MisViajesPage"
             Title="Mis viajes">

    <!-- Ícono de perfil arriba a la derecha -->
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Mi perfil" IconImageSource="perfil.png" Clicked="OnPerfilClicked" />
    </ContentPage.ToolbarItems>

    <Grid Padding="16" RowSpacing="12" RowDefinitions="Auto,*">

        <VerticalStackLayout Grid.Row="0" Spacing="2">
            <Label x:Name="lblSaludo" FontSize="18" FontAttributes="Bold" />
            <Label Text="Viajes en los que participás. Los que ya terminaron se ocultan solos." FontSize="14" />
        </VerticalStackLayout>

        <!-- HU8: viajes del usuario como conductor y como pasajero -->
        <CollectionView x:Name="listaMisViajes" Grid.Row="1" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="Todavía no publicaste ni te anotaste a ningún viaje."
                       HorizontalOptions="Center"
                       Margin="0,30" />
            </CollectionView.EmptyView>
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:Viaje">
                    <Border Padding="12"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#DDDDDD, Dark=#555555}">
                        <!-- El viaje en curso se resalta con borde verde -->
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding Estado}" Value="{x:Static local:EstadoViaje.EnCurso}">
                                <Setter Property="Stroke" Value="#2E9E5B" />
                                <Setter Property="StrokeThickness" Value="2" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Ruta}" FontSize="17" FontAttributes="Bold" />
                                <Label Text="{Binding Detalle}" FontSize="13" />
                                <!-- HU24: punto de partida público del conductor -->
                                <Label Text="{Binding PuntoPartidaTexto}" FontSize="13" IsVisible="{Binding TienePuntoPartida}" />
                                <Label Text="{Binding AsientosDisponibles, StringFormat='Asientos libres: {0}'}" FontSize="13" />
                                <!-- HU14: cuánto paga cada pasajero (solo en viajes con costo) -->
                                <Label Text="{Binding CostoTexto}" FontSize="13" IsVisible="{Binding TieneCosto}" />
                                <Label Text="{Binding PasajerosTexto}" FontSize="13" IsVisible="{Binding EsDelUsuarioActual}" />
                                <!-- Estado según la hora: sale en menos de 5 minutos, en curso o cancelado -->
                                <Label Text="{Binding EstadoTexto}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="#E5484D"
                                       IsVisible="{Binding MostrarEstado}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding Estado}" Value="{x:Static local:EstadoViaje.EnCurso}">
                                            <Setter Property="TextColor" Value="#2E9E5B" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding Estado}" Value="{x:Static local:EstadoViaje.PorSalir}">
                                            <Setter Property="TextColor" Value="#D9822B" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                <!-- Rol del usuario en este viaje -->
                                <Border HorizontalOptions="End"
                                        Padding="10,4"
                                        StrokeShape="RoundRectangle 12"
                                        Stroke="#512BD4"
                                        BackgroundColor="{AppThemeBinding Light=#EFEAFB, Dark=#2A2340}">
                                    <Label Text="{Binding RolUsuarioActual}" FontSize="13" FontAttributes="Bold" />
                                </Border>
                                <!-- HU22: ver el recorrido en Google Maps -->
                                <Button Text="Ver ruta"
                                        BackgroundColor="Transparent"
                                        TextColor="{AppThemeBinding Light=#512BD4, Dark=#AC99EA}"
                                        BorderColor="{AppThemeBinding Light=#512BD4, Dark=#AC99EA}"
                                        BorderWidth="1"
                                        Clicked="OnVerRutaClicked" />
                                <!-- HU5: solo aparece en tus viajes como conductor que no estén cancelados -->
                                <Button Text="Cancelar viaje"
                                        IsVisible="{Binding PuedeCancelar}"
                                        Clicked="OnCancelarViajeClicked" />
                                <!-- HU24: el pasajero carga o cambia dónde lo pasan a buscar -->
                                <Button Text="Mi punto de encuentro"
                                        IsVisible="{Binding PuedeSalirse}"
                                        Clicked="OnMiPuntoClicked" />
                                <!-- HU24: el conductor ve dónde buscar a cada pasajero -->
                                <Button Text="Puntos de encuentro"
                                        IsVisible="{Binding PuedeVerPuntosDeEncuentro}"
                                        Clicked="OnPuntosDeEncuentroClicked" />
                                <!-- HU4: solo aparece en los viajes activos donde estás anotado como pasajero -->
                                <Button Text="Salirme"
                                        IsVisible="{Binding PuedeSalirse}"
                                        Clicked="OnSalirmeClicked" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
