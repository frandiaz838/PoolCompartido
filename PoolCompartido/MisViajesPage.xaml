<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PoolCompartido"
             x:Class="PoolCompartido.MisViajesPage"
             Title="Mis viajes">

    <!-- Ícono de perfil arriba a la derecha -->
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Mi perfil" IconImageSource="perfil.png" Clicked="OnPerfilClicked" />
    </ContentPage.ToolbarItems>

    <ContentPage.Resources>
        <local:ColorAvatarConverter x:Key="ColorAvatar" />
    </ContentPage.Resources>

    <!-- En pantallas anchas (compu) el contenido no se estira de punta a punta -->
    <Grid Padding="16" RowSpacing="12" RowDefinitions="Auto,*" MaximumWidthRequest="980">

        <VerticalStackLayout Grid.Row="0" Spacing="2">
            <Label x:Name="lblSaludo" FontSize="20" FontAttributes="Bold" />
            <Label Text="Viajes en los que participás. Los que ya terminaron se ocultan solos."
                   Style="{StaticResource TextoSecundario}" FontSize="14" />
            <!-- HU15: historial con los viajes que ya terminaron (el texto va antes del interruptor,
                 así en Windows no queda un hueco entre los dos) -->
            <HorizontalStackLayout Spacing="10" Margin="0,6,0,0">
                <Label Text="Ver viajes anteriores" FontSize="14" VerticalOptions="Center" />
                <Switch x:Name="swAnteriores" Toggled="OnVerAnterioresToggled" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <!-- HU8: viajes del usuario como conductor y como pasajero -->
        <CollectionView x:Name="listaMisViajes" Grid.Row="1" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="Todavía no publicaste ni te anotaste a ningún viaje."
                       Style="{StaticResource TextoSecundario}"
                       HorizontalOptions="Center"
                       Margin="0,30" />
            </CollectionView.EmptyView>
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:Viaje">
                    <Border Style="{StaticResource TarjetaViaje}">
                        <!-- El viaje en curso se resalta con borde verde -->
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding Estado}" Value="{x:Static local:EstadoViaje.EnCurso}">
                                <Setter Property="Stroke" Value="{DynamicResource ColorExito}" />
                                <Setter Property="StrokeThickness" Value="2" />
                            </DataTrigger>
                        </Border.Triggers>

                        <VerticalStackLayout Spacing="10">
                            <!-- Encabezado: recorrido en vertical (origen arriba, destino abajo) y rol -->
                            <Grid ColumnDefinitions="14,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                                <BoxView Grid.RowSpan="2" WidthRequest="2" HorizontalOptions="Center" Margin="0,12,0,10"
                                         Color="{AppThemeBinding Light=#C9BEF2, Dark=#5B4E86}" />
                                <Border Grid.Row="0" WidthRequest="12" HeightRequest="12" StrokeShape="RoundRectangle 6" StrokeThickness="2"
                                        VerticalOptions="Start" Margin="0,6,0,0"
                                        Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#262626}" />
                                <Border Grid.Row="1" WidthRequest="12" HeightRequest="12" StrokeShape="RoundRectangle 6" StrokeThickness="0"
                                        VerticalOptions="Start" Margin="0,6,0,0"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                <VerticalStackLayout Grid.Column="1" Grid.Row="0" Spacing="1">
                                    <Label Text="{Binding Origen}" FontSize="17" FontAttributes="Bold" />
                                    <!-- HU24: punto de partida público del conductor -->
                                    <Label Text="{Binding PuntoPartidaTexto}" Style="{StaticResource TextoSecundario}" IsVisible="{Binding TienePuntoPartida}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Grid.Row="1" Text="{Binding Destino}" FontSize="17" FontAttributes="Bold" />
                                <Border Grid.Column="2" Style="{StaticResource Etiqueta}">
                                    <Label Text="{Binding RolUsuarioActual}" FontSize="12" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                </Border>
                            </Grid>

                            <!-- HU29: quiénes viajan (conductor primero) -->
                            <!-- Grid (no HorizontalStackLayout): así en el celular el texto se acomoda en vez de cortarse -->
                            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                                <HorizontalStackLayout Grid.Column="0" Spacing="-8" BindableLayout.ItemsSource="{Binding AvataresVisibles}" VerticalOptions="Center">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="local:Participante">
                                            <Border Style="{StaticResource Avatar}"
                                                    BackgroundColor="{Binding Color, Converter={StaticResource ColorAvatar}}"
                                                    SemanticProperties.Description="{Binding Descripcion}">
                                                <Label Text="{Binding InicialesTexto}" TextColor="White" FontSize="12" FontAttributes="Bold"
                                                       HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </HorizontalStackLayout>
                                <Label Grid.Column="1" Text="{Binding AvataresExtra}" IsVisible="{Binding HayAvataresExtra}"
                                       Style="{StaticResource TextoSecundario}" FontAttributes="Bold" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="{Binding ParticipantesTexto}" Style="{StaticResource TextoSecundario}"
                                       VerticalOptions="Center" MaxLines="2" LineBreakMode="WordWrap" />
                            </Grid>

                            <!-- HU29: datos cortos en chips -->
                            <FlexLayout Wrap="Wrap" Direction="Row" Margin="0,0,0,-6">
                                <Border Style="{StaticResource Chip}">
                                    <Label Text="{Binding HoraChip}" Style="{StaticResource ChipTexto}" />
                                </Border>
                                <!-- Lugares con color según cuántos quedan (siempre con el texto) -->
                                <Border Style="{StaticResource ChipLugares}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding Lugares}" Value="{x:Static local:NivelLugares.Pocos}">
                                            <Setter Property="BackgroundColor" Value="{DynamicResource ColorAvisoFondo}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding Lugares}" Value="{x:Static local:NivelLugares.Completo}">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#EEEEEE, Dark=#333333}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="{Binding AsientosChip}" Style="{StaticResource ChipLugaresTexto}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Lugares}" Value="{x:Static local:NivelLugares.Pocos}">
                                                <Setter Property="TextColor" Value="{DynamicResource ColorAviso}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding Lugares}" Value="{x:Static local:NivelLugares.Completo}">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light=#5E5E5E, Dark=#ACACAC}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                                <!-- HU14: cuánto paga cada pasajero (solo en viajes con costo) -->
                                <Border Style="{StaticResource Chip}" IsVisible="{Binding TieneCostoChip}">
                                    <Label Text="{Binding CostoChip}" Style="{StaticResource ChipTexto}" />
                                </Border>
                            </FlexLayout>

                            <!-- Datos del viaje -->
                            <VerticalStackLayout Spacing="3">
                                <!-- El conductor ve los nombres de sus pasajeros -->
                                <Label Text="{Binding PasajerosTexto}" Style="{StaticResource TextoSecundario}" IsVisible="{Binding EsDelUsuarioActual}" />
                                <!-- Estado según la hora: sale en menos de 5 minutos, en curso o cancelado -->
                                <Label Text="{Binding EstadoTexto}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource ColorPeligro}"
                                       IsVisible="{Binding MostrarEstado}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding Estado}" Value="{x:Static local:EstadoViaje.EnCurso}">
                                            <Setter Property="TextColor" Value="{DynamicResource ColorExito}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding Estado}" Value="{x:Static local:EstadoViaje.PorSalir}">
                                            <Setter Property="TextColor" Value="{DynamicResource ColorAviso}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <!-- HU15: cuántos pasajeros ya subieron (el conductor, con el viaje iniciado) -->
                                <Label Text="{Binding ABordoTexto}" FontSize="13" IsVisible="{Binding MostrarABordo}" />
                                <!-- HU15: el conductor ya confirmó mi PIN -->
                                <Label Text="✓ Estás a bordo" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource ColorExito}" IsVisible="{Binding EstoyABordo}" />
                            </VerticalStackLayout>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#EEEAF6, Dark=#333333}" />

                            <!-- Acciones: en fila y bajan de renglón si no entran (así se ve bien en el celular).
                                 Primero la acción del momento, después las de consulta y al final las de salir o cancelar. -->
                            <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Start" Margin="0,0,0,-8">
                                <!-- HU15: ciclo de vida del viaje (solo el conductor) -->
                                <Button Text="Iniciar viaje" Style="{StaticResource BotonPrincipal}"
                                        IsVisible="{Binding PuedeIniciar}" Clicked="OnIniciarViajeClicked" />
                                <Button Text="Confirmar PIN" Style="{StaticResource BotonPrincipal}"
                                        IsVisible="{Binding PuedeConfirmarPin}" Clicked="OnConfirmarPinClicked" />
                                <Button Text="Finalizar viaje" Style="{StaticResource BotonPrincipal}"
                                        IsVisible="{Binding PuedeFinalizar}" Clicked="OnFinalizarViajeClicked" />
                                <!-- HU15: el pasajero muestra su PIN al subir -->
                                <Button Text="Mi PIN" Style="{StaticResource BotonPrincipal}"
                                        IsVisible="{Binding PuedeVerPin}" Clicked="OnMiPinClicked" />
                                <!-- HU22 / HU24: recorrido con las paradas -->
                                <Button Text="Ver ruta" Style="{StaticResource BotonSecundario}"
                                        Clicked="OnVerRutaClicked" />
                                <!-- HU25: chat grupal del viaje; muestra cuántos mensajes nuevos hay -->
                                <Button Text="{Binding TextoBotonChat}" Style="{StaticResource BotonSecundario}"
                                        IsVisible="{Binding PuedeChatear}" Clicked="OnChatClicked" />
                                <!-- HU32: llamar o escribir por WhatsApp a los del viaje -->
                                <Button Text="Contactar" Style="{StaticResource BotonSecundario}"
                                        IsVisible="{Binding PuedeChatear}" Clicked="OnContactarClicked" />
                                <!-- HU24: el pasajero carga o cambia dónde lo pasan a buscar -->
                                <Button Text="Mi punto de encuentro" Style="{StaticResource BotonSecundario}"
                                        IsVisible="{Binding PuedeSalirse}" Clicked="OnMiPuntoClicked" />
                                <!-- HU24: el conductor ve dónde buscar a cada pasajero -->
                                <Button Text="Puntos de encuentro" Style="{StaticResource BotonSecundario}"
                                        IsVisible="{Binding PuedeVerPuntosDeEncuentro}" Clicked="OnPuntosDeEncuentroClicked" />
                                <!-- HU5: el conductor cancela -->
                                <Button Text="Cancelar viaje" Style="{StaticResource BotonPeligro}"
                                        IsVisible="{Binding PuedeCancelar}" Clicked="OnCancelarViajeClicked" />
                                <!-- HU4: el pasajero se baja -->
                                <Button Text="Salirme" Style="{StaticResource BotonPeligro}"
                                        IsVisible="{Binding PuedeSalirse}" Clicked="OnSalirmeClicked" />
                            </FlexLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
