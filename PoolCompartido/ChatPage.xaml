<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PoolCompartido"
             x:Class="PoolCompartido.ChatPage"
             Title="Chat del viaje"
             Shell.TabBarIsVisible="False"
             SafeAreaEdges="All">

    <!-- HU25: chat grupal del viaje (conductor + pasajeros) -->
    <!-- En la compu la conversación ocupa una columna central, como en cualquier app de mensajes.
         SafeAreaEdges="All": en Android la caja para escribir sube con el teclado y no queda debajo de la barra del sistema -->
    <Grid RowDefinitions="Auto,*,Auto,Auto" MaximumWidthRequest="820">

        <!-- Encabezado: de qué viaje es el chat y quiénes están -->
        <Grid Grid.Row="0" Padding="16,10" ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border WidthRequest="40" HeightRequest="40" StrokeThickness="0" StrokeShape="RoundRectangle 20"
                    BackgroundColor="{AppThemeBinding Light={StaticResource ColorBurbujaPropiaClaro}, Dark={StaticResource ColorBurbujaPropiaOscuro}}">
                <Image Source="icono_auto_blanco.png" WidthRequest="22" HeightRequest="22"
                       AutomationProperties.IsInAccessibleTree="False" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                <Label x:Name="lblRuta" FontSize="{StaticResource TamanoMediano}" FontAttributes="Bold"
                       SemanticProperties.HeadingLevel="Level1" />
                <Label x:Name="lblIntegrantes" Style="{StaticResource TextoSecundario}" LineBreakMode="TailTruncation" />
            </VerticalStackLayout>
        </Grid>

        <!-- Mensajes: los míos a la derecha, los de los demás a la izquierda, los automáticos al centro -->
        <CollectionView x:Name="listaMensajes"
                        Grid.Row="1"
                        Margin="0,4,0,0"
                        SelectionMode="None"
                        ItemsUpdatingScrollMode="KeepLastItemInView">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" Margin="0,40" Spacing="{StaticResource EspacioS}" Padding="16,0">
                    <Label Text="💬" Style="{StaticResource EstadoVacioIcono}" />
                    <Label Text="Todavía no hay mensajes" Style="{StaticResource EstadoVacioTitulo}" />
                    <Label Text="¡Saludá al grupo! Escribí abajo para coordinar el punto de encuentro o avisar si llegás tarde."
                           Style="{StaticResource EstadoVacioTexto}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:MensajeChat">
                    <Grid Padding="12,2">
                        <!-- Mensaje automático: "Ana se sumó al viaje" -->
                        <Label IsVisible="{Binding Sistema}"
                               HorizontalOptions="Center"
                               FontSize="{StaticResource TamanoChico}"
                               FontAttributes="Italic"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource ColorTextoSecundarioClaro}, Dark={StaticResource ColorTextoSecundarioOscuro}}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding AutorNombre}" />
                                    <Span Text=" " />
                                    <Span Text="{Binding Texto}" />
                                    <Span Text=" · " />
                                    <Span Text="{Binding HoraTexto}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <!-- Mensaje de otra persona: globo gris a la izquierda, con su nombre -->
                        <Border IsVisible="{Binding EsDeOtro}"
                                HorizontalOptions="Start"
                                MaximumWidthRequest="420"
                                Padding="12,8"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 4,14,14,14"
                                BackgroundColor="{AppThemeBinding Light={StaticResource ColorSuperficieAlternativaClaro}, Dark={StaticResource ColorSuperficieAlternativaOscuro}}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding AutorNombre}" FontSize="{StaticResource TamanoChico}" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource ColorPrimarioClaro}, Dark={StaticResource ColorPrimarioOscuro}}" />
                                <Label Text="{Binding Texto}" FontSize="{StaticResource TamanoMediano}" LineBreakMode="WordWrap" />
                                <Label Text="{Binding HoraTexto}" FontSize="{StaticResource TamanoChico}" HorizontalOptions="End"
                                       TextColor="{AppThemeBinding Light={StaticResource ColorTextoSecundarioClaro}, Dark={StaticResource ColorTextoSecundarioOscuro}}" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Mensaje mío: globo azul a la derecha -->
                        <Border IsVisible="{Binding EsMioNormal}"
                                HorizontalOptions="End"
                                MaximumWidthRequest="420"
                                Padding="12,8"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 14,4,14,14"
                                BackgroundColor="{AppThemeBinding Light={StaticResource ColorBurbujaPropiaClaro}, Dark={StaticResource ColorBurbujaPropiaOscuro}}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Texto}" FontSize="{StaticResource TamanoMediano}" TextColor="{StaticResource ColorSobreBurbuja}" LineBreakMode="WordWrap" />
                                <Label Text="{Binding HoraTexto}" FontSize="{StaticResource TamanoChico}" TextColor="{StaticResource ColorSobreBurbujaSuave}" HorizontalOptions="End" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Aviso cuando no se puede escribir (viaje terminado, sin internet...) -->
        <Label x:Name="lblAviso"
               Grid.Row="2"
               IsVisible="False"
               Padding="16,6"
               TextColor="{AppThemeBinding Light={StaticResource ColorTextoSecundarioClaro}, Dark={StaticResource ColorTextoSecundarioOscuro}}" />

        <!-- Escribir: caja redondeada con el botón al lado -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="12,8,12,12">
            <Border StrokeThickness="1"
                    StrokeShape="RoundRectangle 22"
                    Padding="14,0"
                    Stroke="{AppThemeBinding Light={StaticResource ColorBordeControlClaro}, Dark={StaticResource ColorBordeControlOscuro}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource ColorSuperficieClaro}, Dark={StaticResource ColorSuperficieOscuro}}">
                <Entry x:Name="entryMensaje"
                       Placeholder="Escribí un mensaje..."
                       MaxLength="500"
                       ReturnType="Send"
                       BackgroundColor="Transparent"
                       VerticalOptions="Center"
                       SemanticProperties.Description="Mensaje"
                       Completed="OnEnviarClicked" />
            </Border>
            <Button x:Name="btnEnviar"
                    Grid.Column="1"
                    Text="Enviar"
                    Style="{StaticResource BotonPrincipal}"
                    HeightRequest="44"
                    CornerRadius="22"
                    Margin="0"
                    Clicked="OnEnviarClicked" />
        </Grid>
    </Grid>

</ContentPage>
