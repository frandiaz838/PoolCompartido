<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PoolCompartido"
             x:Class="PoolCompartido.ChatPage"
             Title="Chat del viaje"
             Shell.TabBarIsVisible="False">

    <!-- HU25: chat grupal del viaje (conductor + pasajeros) -->
    <!-- En la compu la conversación ocupa una columna central, como en cualquier app de mensajes -->
    <Grid RowDefinitions="Auto,*,Auto,Auto" MaximumWidthRequest="820">

        <!-- Encabezado: de qué viaje es el chat y quiénes están -->
        <Grid Grid.Row="0" Padding="16,10" ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border WidthRequest="40" HeightRequest="40" StrokeThickness="0" StrokeShape="RoundRectangle 20"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark=#5B45A8}">
                <Image Source="icono_auto_blanco.png" WidthRequest="22" HeightRequest="22" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                <Label x:Name="lblRuta" FontSize="16" FontAttributes="Bold" />
                <Label x:Name="lblIntegrantes" Style="{StaticResource TextoSecundario}" LineBreakMode="TailTruncation" />
            </VerticalStackLayout>
        </Grid>

        <!-- Mensajes: los míos a la derecha, los de los demás a la izquierda, los automáticos al centro -->
        <CollectionView x:Name="listaMensajes"
                        Grid.Row="1"
                        Margin="0,4,0,0"
                        SelectionMode="None"
                        ItemsUpdatingScrollMode="KeepLastItemInView">
            <CollectionView.EmptyView>
                <Label Text="Todavía no hay mensajes. ¡Saludá al grupo!"
                       HorizontalOptions="Center"
                       Margin="0,40"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:MensajeChat">
                    <Grid Padding="12,2">
                        <!-- Mensaje automático: "Ana se sumó al viaje" -->
                        <Label IsVisible="{Binding Sistema}"
                               HorizontalOptions="Center"
                               FontSize="12"
                               FontAttributes="Italic"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding AutorNombre}" />
                                    <Span Text=" " />
                                    <Span Text="{Binding Texto}" />
                                    <Span Text=" · " />
                                    <Span Text="{Binding HoraTexto}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <!-- Mensaje de otra persona: globo gris a la izquierda, con su nombre -->
                        <Border IsVisible="{Binding EsDeOtro}"
                                HorizontalOptions="Start"
                                MaximumWidthRequest="320"
                                Padding="10,6"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 4,14,14,14"
                                BackgroundColor="{AppThemeBinding Light=#EEEEEE, Dark=#2F2F2F}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding AutorNombre}" FontSize="12" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                <Label Text="{Binding Texto}" FontSize="15" LineBreakMode="WordWrap" />
                                <Label Text="{Binding HoraTexto}" FontSize="11" HorizontalOptions="End"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Mensaje mío: globo violeta a la derecha -->
                        <Border IsVisible="{Binding EsMioNormal}"
                                HorizontalOptions="End"
                                MaximumWidthRequest="320"
                                Padding="10,6"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 14,4,14,14"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark=#5B45A8}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Texto}" FontSize="15" TextColor="White" LineBreakMode="WordWrap" />
                                <Label Text="{Binding HoraTexto}" FontSize="11" TextColor="#DDD5FF" HorizontalOptions="End" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Aviso cuando no se puede escribir (viaje terminado, sin internet...) -->
        <Label x:Name="lblAviso"
               Grid.Row="2"
               IsVisible="False"
               Padding="16,6"
               FontSize="13"
               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />

        <!-- Escribir: caja redondeada con el botón al lado -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="12,8,12,12">
            <Border StrokeThickness="1"
                    StrokeShape="RoundRectangle 22"
                    Padding="14,0"
                    Stroke="{AppThemeBinding Light=#E6E1F2, Dark=#3A3A3A}"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#262626}">
                <Entry x:Name="entryMensaje"
                       Placeholder="Escribí un mensaje..."
                       MaxLength="500"
                       ReturnType="Send"
                       BackgroundColor="Transparent"
                       VerticalOptions="Center"
                       Completed="OnEnviarClicked" />
            </Border>
            <Button x:Name="btnEnviar"
                    Grid.Column="1"
                    Text="Enviar"
                    Style="{StaticResource BotonPrincipal}"
                    HeightRequest="44"
                    CornerRadius="22"
                    Margin="0"
                    Clicked="OnEnviarClicked" />
        </Grid>
    </Grid>

</ContentPage>
