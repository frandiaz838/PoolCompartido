<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- ═════════════════ Colores de la marca ═════════════════
         Solo de referencia (el mismo violeta está en Platforms\Android\Resources\values\colors.xml).
         Las pantallas no los usan directo: usan ColorPrimario, que cambia con el tema. -->
    <Color x:Key="Primary">#512BD4</Color>
    <Color x:Key="PrimaryDark">#AC99EA</Color>

    <!-- ═════════════════ Tokens de diseño ═════════════════
         Cada color del tema tiene su versión "Claro" y "Oscuro". Las pantallas los usan con AppThemeBinding
         (por ejemplo {AppThemeBinding Light={StaticResource ColorTextoClaro}, Dark={StaticResource ColorTextoOscuro}}):
         MAUI cambia cada control solo cuando cambia el tema. En el código se usa ColoresDelTema.Aplicar.
         Los colores de estado (más abajo) van con DynamicResource porque además cambian con la paleta para daltonismo.
         Contrastes medidos (norma WCAG AA): texto ≥ 4,5:1 y bordes de controles ≥ 3:1 contra el fondo y la superficie. -->

    <!-- Fondo de las pantallas y superficie de las tarjetas -->
    <Color x:Key="ColorFondoClaro">#F7F6FB</Color>
    <Color x:Key="ColorFondoOscuro">#1A1A1D</Color>

    <Color x:Key="ColorSuperficieClaro">#FFFFFF</Color>
    <Color x:Key="ColorSuperficieOscuro">#25242A</Color>

    <!-- Superficie gris suave: chip "Completo", globo de chat de los demás -->
    <Color x:Key="ColorSuperficieAlternativaClaro">#F0EEF5</Color>
    <Color x:Key="ColorSuperficieAlternativaOscuro">#312F37</Color>

    <!-- Bordes: decorativo (tarjetas, separadores) y de controles (campos, botones con contorno: ≥ 3:1) -->
    <Color x:Key="ColorBordeClaro">#E3DEEF</Color>
    <Color x:Key="ColorBordeOscuro">#3A3842</Color>

    <Color x:Key="ColorBordeControlClaro">#8B83A3</Color>
    <Color x:Key="ColorBordeControlOscuro">#8D879C</Color>

    <!-- Textos -->
    <Color x:Key="ColorTextoClaro">#1C1B1F</Color>
    <Color x:Key="ColorTextoOscuro">#F2F1F5</Color>

    <Color x:Key="ColorTextoSecundarioClaro">#5C5868</Color>
    <Color x:Key="ColorTextoSecundarioOscuro">#B9B5C4</Color>

    <Color x:Key="ColorTextoDeshabilitadoClaro">#8E8A99</Color>
    <Color x:Key="ColorTextoDeshabilitadoOscuro">#86828F</Color>

    <Color x:Key="ColorPlaceholderClaro">#6B6778</Color>
    <Color x:Key="ColorPlaceholderOscuro">#A19DAD</Color>

    <!-- Fondo de los campos (texto, listas, fecha, hora). En Windows el campo necesita fondo para que se vea la caja;
         en Android va transparente y se ve la línea de abajo -->
    <OnPlatform x:Key="ColorFondoCampoClaro" x:TypeArguments="Color" Default="Transparent">
        <On Platform="WinUI" Value="#FFFFFF" />
    </OnPlatform>
    <OnPlatform x:Key="ColorFondoCampoOscuro" x:TypeArguments="Color" Default="Transparent">
        <On Platform="WinUI" Value="#25242A" />
    </OnPlatform>

    <!-- Botón deshabilitado: fondo gris con el texto legible (antes era el mismo botón al 50 %) -->
    <Color x:Key="ColorDeshabilitadoFondoClaro">#E4E2EA</Color>
    <Color x:Key="ColorDeshabilitadoFondoOscuro">#34323A</Color>

    <Color x:Key="ColorDeshabilitadoTextoClaro">#6F6B7A</Color>
    <Color x:Key="ColorDeshabilitadoTextoOscuro">#9D99A8</Color>

    <!-- Violeta de la app y lo que va encima -->
    <Color x:Key="ColorPrimarioClaro">#512BD4</Color>
    <Color x:Key="ColorPrimarioOscuro">#AC99EA</Color>

    <Color x:Key="ColorSobrePrimarioClaro">#FFFFFF</Color>
    <Color x:Key="ColorSobrePrimarioOscuro">#1C1B1F</Color>

    <!-- Violeta suave: chips, etiquetas ("Tu viaje"), día elegido -->
    <Color x:Key="ColorPrimarioSuaveClaro">#EFEAFB</Color>
    <Color x:Key="ColorPrimarioSuaveOscuro">#352D52</Color>

    <Color x:Key="ColorSobrePrimarioSuaveClaro">#3B2A80</Color>
    <Color x:Key="ColorSobrePrimarioSuaveOscuro">#DDD4FA</Color>

    <!-- Línea del recorrido en las tarjetas (decorativa) -->
    <Color x:Key="ColorLineaRecorridoClaro">#C9BEF2</Color>
    <Color x:Key="ColorLineaRecorridoOscuro">#5B4E86</Color>

    <!-- Tarjeta "Tu próximo viaje": degradé violeta con texto blanco en los dos temas -->
    <LinearGradientBrush x:Key="FondoHeroClaro" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#512BD4" Offset="0" />
        <GradientStop Color="#6A45D9" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="FondoHeroOscuro" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4A2CB8" Offset="0" />
        <GradientStop Color="#5E40C9" Offset="1" />
    </LinearGradientBrush>

    <Color x:Key="ColorSobreHero">#FFFFFF</Color>
    <Color x:Key="ColorSobreHeroSuave">#EDE7FF</Color>
    <!-- Contorno de los botones secundarios sobre el degradé (≥ 3:1) -->
    <Color x:Key="ColorHeroBorde">#D9CCFF</Color>
    <!-- Etiqueta de estado sobre el degradé (oscurece un poco el violeta: el texto blanco queda con ≥ 4,5:1) -->
    <Color x:Key="ColorHeroEtiqueta">#33000000</Color>
    <!-- Texto del botón blanco de la tarjeta: el violeta oscuro en los dos temas -->
    <Color x:Key="ColorTextoBotonHero">#512BD4</Color>

    <!-- Chat: mi globo (violeta) y el de los demás (gris) -->
    <Color x:Key="ColorBurbujaPropiaClaro">#512BD4</Color>
    <Color x:Key="ColorBurbujaPropiaOscuro">#5B45A8</Color>

    <Color x:Key="ColorSobreBurbuja">#FFFFFF</Color>
    <Color x:Key="ColorSobreBurbujaSuave">#E4DCFF</Color>

    <!-- Barra de pestañas: un tono apenas distinto del fondo -->
    <Color x:Key="ColorBarraPestanasClaro">#F1EEF9</Color>
    <Color x:Key="ColorBarraPestanasOscuro">#232227</Color>

    <Color x:Key="ColorSombra">#000000</Color>

    <!-- Iniciales de los avatares (las de color fuerte de abajo): ≥ 5:1 con blanco -->
    <Color x:Key="ColorSobreAvatar">#FFFFFF</Color>
    <Color x:Key="ColorAvatar0">#5B45A8</Color>
    <Color x:Key="ColorAvatar1">#0E6E7A</Color>
    <Color x:Key="ColorAvatar2">#A63D63</Color>
    <Color x:Key="ColorAvatar3">#2F62A8</Color>
    <Color x:Key="ColorAvatar4">#8A5A12</Color>
    <Color x:Key="ColorAvatar5">#2E6E3E</Color>
    <Color x:Key="ColorAvatar6">#7A4FB8</Color>
    <Color x:Key="ColorAvatar7">#B04A2E</Color>

    <!-- HU19: colores de estado. Las pantallas los usan con DynamicResource y ServicioApariencia
         los cambia según el tema y la paleta para daltonismo (Paleta.cs; estos son solo los valores iniciales) -->
    <Color x:Key="ColorExito">#1B7F48</Color>
    <Color x:Key="ColorExitoFondo">#EDF8F1</Color>
    <Color x:Key="ColorPeligro">#C62828</Color>
    <Color x:Key="ColorPeligroBorde">#D35454</Color>
    <Color x:Key="ColorSobrePeligro">#FFFFFF</Color>
    <Color x:Key="ColorAviso">#A85A0A</Color>
    <Color x:Key="ColorAvisoFondo">#FFF6E8</Color>

    <!-- ═════════════════ Escala de letras ═════════════════ -->
    <x:Double x:Key="TamanoChico">12</x:Double>
    <x:Double x:Key="TamanoNormal">14</x:Double>
    <x:Double x:Key="TamanoMediano">16</x:Double>
    <x:Double x:Key="TamanoGrande">18</x:Double>
    <x:Double x:Key="TamanoTitulo">22</x:Double>
    <x:Double x:Key="TamanoPortada">28</x:Double>

    <!-- ═════════════════ Espaciado (múltiplos de 4) ═════════════════ -->
    <x:Double x:Key="EspacioXS">4</x:Double>
    <x:Double x:Key="EspacioS">8</x:Double>
    <x:Double x:Key="EspacioM">12</x:Double>
    <x:Double x:Key="EspacioL">16</x:Double>
    <x:Double x:Key="EspacioXL">24</x:Double>

    <Thickness x:Key="RellenoPagina">16</Thickness>
    <Thickness x:Key="RellenoFormulario">16,16,16,24</Thickness>
    <Thickness x:Key="RellenoTarjeta">16,14</Thickness>

    <!-- Ancho máximo del contenido en pantallas anchas (compu) -->
    <x:Double x:Key="AnchoFormulario">560</x:Double>
    <x:Double x:Key="AnchoLectura">760</x:Double>
    <!-- Listas de viajes: una columna central, ancha para que las tarjetas se lean cómodas -->
    <x:Double x:Key="AnchoLista">980</x:Double>
</ResourceDictionary>