<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PoolCompartido.HorarioPage"
             Title="Mi horario"
             Shell.TabBarIsVisible="False">

    <!-- HU30: cargar o editar un horario habitual -->
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="8" MaximumWidthRequest="520">

            <Label Text="¿Qué días viajás?" FontAttributes="Bold" />
            <!-- Los botones de los días se arman en el código (Lun a Dom); tocás para marcar o desmarcar -->
            <FlexLayout x:Name="panelDias" Wrap="Wrap" Direction="Row" />

            <Label Text="¿A qué hora salís?" FontAttributes="Bold" Margin="0,12,0,0" />
            <TimePicker x:Name="tpHora" Format="HH:mm" HorizontalOptions="Start" />
            <Label Text="Te mostramos los viajes que salen hasta una hora antes o después."
                   Style="{StaticResource TextoSecundario}" FontSize="12" />

            <Label Text="Desde (opcional)" FontAttributes="Bold" Margin="0,12,0,0" />
            <Entry x:Name="entryOrigen" Placeholder="Ej: Saldán" MaxLength="100" />

            <Label Text="Hacia" FontAttributes="Bold" Margin="0,12,0,0" />
            <Entry x:Name="entryDestino" Placeholder="Ej: Universidad Blas Pascal" MaxLength="100" />

            <Label x:Name="lblError" TextColor="{DynamicResource ColorPeligro}" IsVisible="False" Margin="0,8,0,0" />

            <Button x:Name="btnGuardar" Text="Guardar horario" Style="{StaticResource BotonPrincipal}"
                    HorizontalOptions="Fill" Margin="0,16,0,0" Clicked="OnGuardarClicked" />
            <Button x:Name="btnBorrar" Text="Borrar este horario" Style="{StaticResource BotonPeligro}"
                    HorizontalOptions="Fill" IsVisible="False" Clicked="OnBorrarClicked" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
