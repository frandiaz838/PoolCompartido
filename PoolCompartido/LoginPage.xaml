<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PoolCompartido"
             x:Class="PoolCompartido.LoginPage"
             Title="Pool Compartido"
             SafeAreaEdges="All">

    <Grid>
        <ScrollView>
            <!-- Grid: así el formulario (con ancho máximo) queda centrado en la compu -->
            <Grid>
                <VerticalStackLayout Padding="24"
                                     Spacing="{StaticResource EspacioS}"
                                     MaximumWidthRequest="420"
                                     VerticalOptions="Center">

                    <Label Text="Pool Compartido"
                           Style="{StaticResource TituloPortada}"
                           TextColor="{AppThemeBinding Light={StaticResource ColorPrimarioClaro}, Dark={StaticResource ColorPrimarioOscuro}}" />
                    <Label x:Name="lblSubtitulo"
                           Text="Iniciá sesión para ver y compartir viajes"
                           Style="{StaticResource TextoSecundario}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           Margin="0,0,0,16" />

                    <!-- Solo se muestra al crear una cuenta -->
                    <Label x:Name="lblNombre" Text="Tu nombre" Style="{StaticResource RotuloCampo}" Margin="0" IsVisible="False" />
                    <Entry x:Name="entryNombre" Placeholder="Ej: Francisco" IsVisible="False" SemanticProperties.Description="Tu nombre" />

                    <Label Text="Mail" Style="{StaticResource RotuloCampo}" Margin="0,4,0,0" />
                    <Entry x:Name="entryEmail" Placeholder="tu@mail.com" Keyboard="Email" SemanticProperties.Description="Mail" />

                    <Label Text="Contraseña" Style="{StaticResource RotuloCampo}" Margin="0,4,0,0" />
                    <!-- Contraseña con el ícono para mostrarla/ocultarla dentro del campo, al final -->
                    <Grid>
                        <local:EntryConIcono x:Name="entryContrasena" Placeholder="Mínimo 6 caracteres" IsPassword="True"
                                             SemanticProperties.Description="Contraseña" />
                        <ImageButton x:Name="btnVerContrasena"
                                     Source="ojo.png"
                                     WidthRequest="44"
                                     HeightRequest="44"
                                     Padding="13"
                                     Margin="0,0,2,0"
                                     HorizontalOptions="End"
                                     VerticalOptions="Center"
                                     BackgroundColor="Transparent"
                                     SemanticProperties.Description="Mostrar contraseña"
                                     Clicked="OnVerContrasenaClicked" />
                    </Grid>

                    <Label x:Name="lblError" Style="{StaticResource TextoError}" IsVisible="False" />

                    <Button x:Name="btnPrincipal"
                            Text="Iniciar sesión"
                            Margin="0,16,0,0"
                            Clicked="OnPrincipalClicked" />
                    <Button x:Name="btnOlvide"
                            Text="¿Olvidaste tu contraseña?"
                            Style="{StaticResource BotonTexto}"
                            TextColor="{AppThemeBinding Light={StaticResource ColorTextoSecundarioClaro}, Dark={StaticResource ColorTextoSecundarioOscuro}}"
                            Clicked="OnOlvideClicked" />
                    <Button x:Name="btnCambiarModo"
                            Text="¿No tenés cuenta? Creá una"
                            Style="{StaticResource BotonTexto}"
                            Clicked="OnCambiarModoClicked" />
                </VerticalStackLayout>
            </Grid>
        </ScrollView>

        <ActivityIndicator x:Name="indicador"
                           IsRunning="False"
                           IsVisible="False"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
    </Grid>

</ContentPage>
